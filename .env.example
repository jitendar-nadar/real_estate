# MongoDB connection string (required for app to run)
MONGODB_URI=mongodb://localhost:27017
# Optional: database name (default: realestate)
MONGODB_DB_NAME=realestate

# NextAuth (required for login and session)
NEXTAUTH_SECRET=your-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# JWT for API Bearer tokens (optional; falls back to NEXTAUTH_SECRET)
JWT_SECRET=your-jwt-secret

# Public site URL (required for production — SEO, sitemap, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Company / site branding (configure per client deployment) ---
NEXT_PUBLIC_COMPANY_NAME=Your Realty
# Logo URL or path (e.g. /logo.png or https://cdn.example.com/logo.png)
# NEXT_PUBLIC_COMPANY_LOGO=/logo.png
NEXT_PUBLIC_COMPANY_TAGLINE=Discover premium residential and commercial properties tailored to your needs.
NEXT_PUBLIC_HERO_HEADLINE=Find your next property with confidence
NEXT_PUBLIC_HERO_SUBHEADLINE=Browse verified listings, filter by location and budget, and connect with our team on any device.
# Primary brand color (hex)
NEXT_PUBLIC_PRIMARY_COLOR=#0284c7
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourcompany.com
NEXT_PUBLIC_COMPANY_ADDRESS=123 Business Park, Mumbai, Maharashtra 400001
# Social links — use individual vars or JSON
# NEXT_PUBLIC_SOCIAL_LINKS={"facebook":"https://facebook.com/yourpage","instagram":"https://instagram.com/yourpage","whatsapp":"https://wa.me/919876543210"}

# Demo seed data (development only; never enable in production)
# SEED_DEMO_DATA=true
